# Copy to .env and fill in. Never commit the real .env.
PORT=4000

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=rcms
PGPASSWORD=
PGDATABASE=rcms

# Signs login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: passwords for the accounts created by `npm run seed`.
SEED_ADMIN_PASSWORD=
SEED_OFFICE_PASSWORD=
SEED_SHOP_PASSWORD=
